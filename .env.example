# Runtime environment
NODE_ENV=development
API_PORT=3001

# PostgreSQL connection used by the API and Drizzle CLI.
# Replace the placeholder values in your local .env file.
DATABASE_URL=postgresql://edutech:change-me@localhost:5432/edutech

# Browser-visible URL used only by the web app to reach the public health endpoint.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Docker Compose PostgreSQL settings. Use local, non-production values.
POSTGRES_DB=edutech
POSTGRES_USER=edutech
POSTGRES_PASSWORD=change-me
